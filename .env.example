# NotiLab — environment template.
#
# Copy to `.env` and fill in. This file is committed and MUST NEVER contain a
# real value: every entry below is a placeholder or an empty string.
#
# Full reference: DEPLOYMENT.md § Environment Variables.

# ── Database ────────────────────────────────────────────────────────────────
# NOTE: on this project the local and production deployments have historically
# pointed at the same Neon database. Check before running any db:* script.
DATABASE_URL="postgresql://user:password@localhost:5432/notilab"

# ── Admin authentication (humans) ───────────────────────────────────────────
# Mandatory, no fallback. Unset, blank or shorter than 32 characters means no
# admin session can be signed and every admin page redirects to login.
#   openssl rand -hex 32
JWT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── Public origin ───────────────────────────────────────────────────────────
# Optional. Resolved by lib/base-url.ts; falls back to Vercel's system variable.
NEXT_PUBLIC_BASE_URL=""

# ── Background jobs ─────────────────────────────────────────────────────────
# Guards every /api/cron/* route. Without it they return 500.
CRON_SECRET=""

# ── News ingestion (optional) ───────────────────────────────────────────────
# Absent keys make the provider return [] rather than raise an error.
GNEWS_API_KEY=""
NEWSAPI_KEY=""

# ── AI services (optional) ──────────────────────────────────────────────────
OPENAI_API_KEY=""
GROQ_API_KEY=""

# ── Email (optional) ────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ── Agent Management API (optional) ─────────────────────────────────────────
# HTTP transport for external agents. Disabled unless a key is set: with none,
# every /api/agent/* endpoint answers AGENT_API_DISABLED.
# Minimum 32 characters:  openssl rand -hex 32
# Contract: docs/agent-api.md
NOTILAB_AGENT_API_KEY=""
NOTILAB_AGENT_ID="abacus"
# readonly | editorial | seo | comma-separated list of individual permissions
NOTILAB_AGENT_PERMISSIONS="readonly"
# Optional overrides.
# NOTILAB_AGENT_API_KEYS=            # JSON array, for several agents with different grants
# NOTILAB_AGENT_RATE_LIMIT=120
# NOTILAB_AGENT_RATE_WINDOW_MS=60000
# NOTILAB_AGENT_CONFIRMATION_SECRET=

# ── MCP server (optional) ───────────────────────────────────────────────────
# Remote MCP transport over the same tools and the same pipeline, for Abacus.ai,
# ChatGPT and any future internal agent. One endpoint, several clients.
# Separate credentials from the Agent API on purpose: revoking one transport
# must not revoke the other, and the audit trail distinguishes them. Disabled
# unless at least one client is configured — there is no fallback to
# NOTILAB_AGENT_API_KEY.
# Contract: docs/mcp.md
#
# The roster. A JSON object keyed by client id; the id is what appears in every
# audit row as agent:<id>, keys the rate limiter and namespaces idempotency
# keys, so give each client its own. Each apiKey is minimum 32 characters and
# must be unique across clients — two clients sharing a key are BOTH refused,
# because a request could not then be attributed to either.
#   apiKey                  required, min 32 chars:  openssl rand -hex 32
#   permissions             readonly | editorial | seo | comma-separated list.
#                           Omitted grants readonly, never more.
#   label                   optional, for logs
#   disabled                true revokes the client without deleting its config
#   skipCriticalConfirmation  true exempts it from the confirmation gate on
#                           approve/publish/unpublish/archive. Deliberate risk
#                           acceptance for an unattended pipeline — leave unset.
#
# Keep this on ONE line. Never commit a real value.
# NOTILAB_MCP_CLIENTS_JSON={"abacus":{"apiKey":"<64 hex chars>","permissions":"editorial","label":"Abacus.ai"},"chatgpt":{"apiKey":"<64 hex chars>","permissions":"readonly","label":"ChatGPT"}}
NOTILAB_MCP_CLIENTS_JSON=""

# Legacy single-client variables. Still honoured, and they coexist with the
# roster above so an existing deployment keeps working across the upgrade.
# Prefer NOTILAB_MCP_CLIENTS_JSON for anything new.
# NOTILAB_MCP_API_KEY=""
# NOTILAB_MCP_AGENT_ID="abacus-mcp"
# NOTILAB_MCP_PERMISSIONS="editorial"

# How long two identical mutating calls count as one retry. Default 900000 (15m).
# NOTILAB_MCP_IDEMPOTENCY_WINDOW_MS=900000
