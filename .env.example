# Copy to .env and fill in real values. Required vars must be set for the app to build/run;
# optional vars gate specific features (that feature no-ops or errors clearly if unset).

# --- Database (required) ---
DATABASE_URL="postgresql://user:password@localhost:5432/notilab"

# --- Auth (required) ---
# Signs the admin session JWT (lib/admin-auth.ts). Falls back to an insecure
# default if unset, so always set a real value outside local throwaway use.
JWT_SECRET="your-super-secret-jwt-key-here"

# --- Cron endpoints (required for Vercel Cron / scheduled jobs) ---
# Shared secret checked as `Authorization: Bearer $CRON_SECRET` by app/api/cron/**.
CRON_SECRET="your-cron-secret"

# --- Public base URL (optional, defaults to https://notilab.app) ---
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- AI providers (optional; AI news processing/chat no-ops without at least one) ---
OPENAI_API_KEY="sk-..."
GROQ_API_KEY="gsk_..."

# --- News ingestion sources (optional; each source is skipped without its key) ---
GNEWS_API_KEY=""
NEWSAPI_KEY=""

# --- Trends (optional) ---
SERPAPI_KEY=""

# --- Digest email via Resend (optional; digest send no-ops without RESEND_API_KEY) ---
RESEND_API_KEY=""
DIGEST_FROM_EMAIL="NotiLab <digest@notilab.app>"

# --- WhatsApp messaging (optional) ---
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_VERIFY_TOKEN=""

# --- Telegram messaging (optional) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# --- Growth engine (optional, defaults to "notilab") ---
# Salt used when hashing anonymous visitor IPs for referral/share analytics.
IP_HASH_SALT="notilab"
